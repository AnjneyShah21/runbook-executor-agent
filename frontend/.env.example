# Google OAuth Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# Public flag for client-side Google auth detection
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# TrueForge Backend Agent URL (e.g., hosted on Render / Railway / Fly.io)
TRUEFORGE_API_URL=http://localhost:3000/api/v1
TRUEFORGE_API_KEY=tf_sk_runbook_executor_hackathon_2026_demo_key
